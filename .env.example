# Frontend build-time settings (these are PUBLIC — they end up in the browser bundle).
# Never put a Gemini key here.

# Optional: URL of the AI proxy Worker. Leave empty for the fully offline engine.
VITE_API_URL=

# Optional: base path. Default "/PhysiStep/". Use "/" for <user>.github.io repos or a custom domain.
# VITE_BASE=/PhysiStep/
